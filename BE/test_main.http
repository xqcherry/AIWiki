# Test your FastAPI endpoints

GET http://127.0.0.1:8000/
Accept: application/json

###

GET http://127.0.0.1:8000/hello/xqcherry
Accept: application/json

###

# 创建文档
POST http://127.0.0.1:8000/docus/
Content-Type: application/json
Accept: application/json

{
  "title": "第二篇文档",
  "content": "这是内容，支持 Markdown"
}

###

# 获取文档列表
GET http://127.0.0.1:8000/docus/?skip=0&limit=10
Accept: application/json

###

# 获取单个文档（把 1 改成你实际创建返回的 id）
GET http://127.0.0.1:8000/docus/1
Accept: application/json

###

# 更新文档（把 1 改成你实际创建返回的 id）
PUT http://127.0.0.1:8000/docus/1
Content-Type: application/json
Accept: application/json

{
  "title": "更新后的标题",
  "content": "更新后的内容"
}

###

# 删除文档（把 1 改成你实际创建返回的 id）
DELETE http://127.0.0.1:8000/docus/1
Accept: application/json